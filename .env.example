# Spring Boot (use the direct Neon host in production so Flyway can run safely).
DB_URL=jdbc:postgresql://localhost:5433/leetbrofinder
DB_USERNAME=leetbro
DB_PASSWORD=replace-with-a-local-password

# Local Docker Compose PostgreSQL.
POSTGRES_PASSWORD=replace-with-the-same-local-password
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql

# Vite. Leave empty locally to use the Vite /api proxy.
VITE_API_URL=
